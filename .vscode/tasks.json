{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Mini RTOS Scheduler",
      "type": "shell",
      "command": "gcc",
      "args": [
        "main.c",
        "can_bus.c",
        "temp_sensor_ecu.c",
        "engine_ecu.c",
        "dashboard_ecu.c",
        "-Wall",
        "-Wextra",
        "-g3",
        "-o",
        "output/mini_rtos.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
